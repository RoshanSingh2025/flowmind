# --- App ---
ENVIRONMENT=development           # development | staging | production | test
PROJECT_NAME=FlowMind
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-prod-please-use-a-long-random-string

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# Local development default (zero setup, no separate DB server required):
DATABASE_URL=sqlite+aiosqlite:///./flowmind.db
# For staging/production, point at PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+asyncpg://flowmind:flowmind@localhost:5432/flowmind
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vector store, reserved for AI phase) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Uploads ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_UPLOAD_EXTENSIONS=[".mp4"]
ALLOWED_UPLOAD_MIME_TYPES=["video/mp4"]